{% if "bashrc" in item.dst %}
# .bashrc

# Source global definitions
if [ -f /etc/bashrc ]; then
	. /etc/bashrc
fi

function remove_path(){
  PATH=:$PATH:
  PATH=${PATH//:$1:/:}
  PATH=${PATH#:}; PATH=${PATH%:}
  export PATH
}
{% endif %}

# User specific environment
if [[ -z "${M_PYTHON_SITELIB}" ]]
then
    PATH="$HOME/.local/bin:$HOME/bin:$PATH"
{% if ansible_facts['os_family'] == "Darwin" %}
    PATH="$(brew --prefix rustup)/bin:$PATH"
{% else %}
    PATH="$HOME/.cargo/bin:$PATH"
{% endif %}
    PATH="$HOME/.npm/bin:$PATH"
    export LD_LIBRARY_PATH="$HOME/.local/lib64/:$HOME/.local/lib/:$LD_LIBRARY_PATH"
    export PKG_CONFIG_PATH=$HOME/.local/share/pkgconfig/
    export M_PYTHON_SITELIB="$(python3 -c "import site; print(site.USER_SITE)")"
    export GOPATH=$HOME/.local/go
fi
export PATH
export EDITOR=nvim

{% if ansible_facts['os_family'] == "Darwin" %}
export CTEST_PARALLEL_LEVEL=$(sysctl -n hw.physicalcpu)
{% else %}
export CTEST_PARALLEL_LEVEL=$(nproc)
{% endif %}
export BAT_THEME="Solarized (light)"
export HISTSIZE=100000
export SCCACHE_IGNORE_SERVER_IO_ERROR=1
export ANSIBLE_VAULT_PASSWORD_FILE="./.vault_pass"
export ANSIBLE_SSH_CONTROL_PATH="$HOME/.ssh/.control_channels/%%h:%%p:%%r"
export huggingface_token={{hugging_face_token}}
export HF_HOME={{hf_home}}
{% if 'laptop' in group_names %}
export SRC_ENDPOINT="http://delta:7080"
export SRC_ACCESS_TOKEN="{{srcgraph_token}}"
{% endif %}

function use_build() {
    {{setup_spack_build_env}}
}
{% if has_cuda %}
function use_cuda() {
    export CUDAARCHS="{{cuda_arch}}"
    export PATH="{{cuda_dir}}:$PATH"
}
{% endif %}


{% if "bashrc" in item.dst %}
# User specific aliases and functions
if [ -d ~/.bashrc.d ]; then
	for rc in ~/.bashrc.d/*; do
		if [ -f "$rc" ]; then
			. "$rc"
		fi
	done
fi
unset rc
{% endif %}


# exit early if non-interactive
[[ $- != *i* ]] && return


alias vim=nvim
function o() {
  xdg-open "$@"
}

stty werase undef

export FZF_DEFAULT_COMMAND='fd --type f --strip-cwd-prefix'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"



{% if "bashrc" in item.dst %}
bind '\C-w:unix-filename-rubout'
eval "$(fzf --bash)"
eval "$(starship init bash)"
eval "$(zoxide init bash)"
{% elif "zshrc" in item.dst %}
eval "$(fzf --zsh)"
eval "$(starship init zsh)"
eval "$(zoxide init zsh)"
{% endif %}
{{site_settings}}
